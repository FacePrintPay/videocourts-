<script>
// ============ STATE ============
let state = {
  role: null,
  caseType: null,
  phase: -1,
  evidence: 0,
  objections: 0,
  witnesses: 0,
  started: false,
  phases: ['Opening','Evidence','Witness','Cross','Closing','Deliberation','Verdict']
};

let currentMonth = new Date().getMonth();
let currentYear = new Date().getFullYear();
let hearings = [
  {id:1, caseNumber:'CR-24-1867', type:'First Appearance (Remote)', date:new Date(currentYear, currentMonth, 20, 10, 0).toISOString(), location:'Cabarrus County Detention Center to District 19A', status:'Scheduled'},
  {id:2, caseNumber:'CR-24-1868', type:'Capacity to Proceed', date:new Date(currentYear, currentMonth, 21, 14, 0).toISOString(), location:'Central Regional Hospital to District 15B', status:'Scheduled'}
];

// ============ NC FACILITIES ============
const FACILITIES = {
  'county': ['Mecklenburg County Jail', 'Cabarrus County Detention Center', 'Wake County Detention Center'],
  'dacjj': ['Central Prison (Raleigh)', 'Polk Correctional Institution'],
  'crh': ['Central Regional Hospital (Butner)']
};

// ============ NAVIGATION ============
function scrollToSection(sectionId) {
  const element = document.getElementById(sectionId);
  if (element) {
    element.scrollIntoView({ behavior: 'smooth', block: 'start' });
    showToast(`Navigated to ${sectionId}`, 'success');
  }
}

// ============ TOAST ============
function showToast(msg,type='success'){
  const t=document.getElementById('toast');
  t.textContent=msg;
  t.className='toast show '+type;
  clearTimeout(window._tt);
  window._tt=setTimeout(()=>t.classList.remove('show'),3500);
}

// ============ SELECTION ============
function selectRole(role,el){
  state.role=role;
  el.parentElement.querySelectorAll('.mock-role').forEach(e=>e.classList.remove('selected'));
  el.classList.add('selected');
  updatePreview();
  showToast(`Role selected: ${role}`, 'success');
}
function selectCase(c,el){
  state.caseType=c;
  el.parentElement.querySelectorAll('.mock-role').forEach(e=>e.classList.remove('selected'));
  el.classList.add('selected');
  updatePreview();
  showToast(`Case type selected: ${c}`, 'success');
}

function updatePreview(){
  const sub=document.getElementById('previewSubtitle');
  if(state.role && state.caseType){
    sub.textContent=state.role+' · '+state.caseType+' · Ready to begin';
  } else if(state.role){
    sub.textContent=state.role+' selected · Choose a case type';
  } else if(state.caseType){
    sub.textContent=state.caseType+' selected · Choose your role';
  } else {
    sub.textContent='Start a trial to see the courtroom come alive.';
  }
}

// ============ START TRIAL ============
function startTrial(){
  if(!state.role){showToast('Please select a role','error');return}
  if(!state.caseType){showToast('Please select a case type','error');return}
  
  state.started=true;
  state.phase=0;
  state.evidence=0;
  state.objections=0;
  state.witnesses=0;
  
  document.getElementById('trialTitle').textContent=state.caseType;
  document.getElementById('trialSubtitle2').textContent='Role: '+state.role+' · Presiding: Hon. Martinez';
  document.getElementById('trialBadge').innerHTML='<span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>LIVE';
  document.getElementById('trialBadge').className='badge badge-live';
  document.getElementById('roleDisplay').textContent=state.role;
  document.getElementById('phaseDisplay').textContent='Opening';
  document.getElementById('statPhase').textContent='Opening';
  
  updatePhaseDots();
  highlightTile('judge');
  
  const transcript=document.getElementById('transcript');
  transcript.innerHTML='';
  addMsg('system','<strong>Bailiff:</strong> All rise. The Honorable Judge Martinez presiding.');
  addMsg('judge','<strong>Judge Martinez:</strong> Be seated. This court is now in session for the matter of '+state.caseType+'. '+state.role+', you may proceed with your opening statement.');
  
  showToast('Trial started: '+state.caseType,'success');
  setTimeout(()=>scrollToSection('preview'),300);
}

// ============ PHASE DOTS ============
function updatePhaseDots(){
  for(let i=0;i<7;i++){
    const dot=document.getElementById('phase-'+i);
    dot.className='phase-dot';
    if(i<state.phase)dot.classList.add('done');
    else if(i===state.phase)dot.classList.add('active');
  }
}

// ============ TILE HIGHLIGHTING ============
function highlightTile(who){
  document.querySelectorAll('.video-tile').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.vt-speaking').forEach(s=>s.style.display='none');
  const tile=document.getElementById('tile-'+who);
  if(tile){
    tile.classList.add('active');
    const speak=document.getElementById('speak-'+who);
    if(speak)speak.style.display='flex';
  }
}

// ============ ADD MESSAGE ============
function addMsg(type,html){
  const transcript=document.getElementById('transcript');
  const msg=document.createElement('div');
  msg.className='chat-msg '+type;
  msg.innerHTML=html;
  transcript.appendChild(msg);
  transcript.scrollTop=transcript.scrollHeight;
}

// ============ TRIAL ACTIONS ============
function trialAction(action){
  if(!state.started){showToast('Start a trial first','error');return}
  
  const responses={
    opening:{
      phase:0,
      speaker:state.role.toLowerCase()==='prosecution'?'prosecution':'defense',
      msgs:[
        {type:'ai',html:'<strong>'+state.role+':</strong> Your Honor, members of the jury, the evidence in this case will clearly show that the defendant is '+(state.role==='Prosecution'?'guilty of the charges':'not guilty')+'. We will present compelling testimony and physical evidence that supports our position.'},
        {type:'judge',html:'<strong>Judge Martinez:</strong> Thank you, counsel. The jury will disregard any statements not supported by evidence.'}
      ]
    },
    evidence:{
      phase:1,
      speaker:state.role.toLowerCase()==='prosecution'?'prosecution':'defense',
      msgs:[
        {type:'ai',html:'<strong>'+state.role+':</strong> Your Honor, I\'d like to enter Exhibit '+(++state.evidence)+' into evidence. This '+(state.caseType.includes('Theft')?'surveillance footage':state.caseType.includes('Assault')?'medical report':state.caseType.includes('Contract')?'signed agreement':state.caseType.includes('Custody')?'psychological evaluation':state.caseType.includes('DUI')?'breathalyzer result':'financial record')+' is directly relevant to the charges.'},
        {type:'system',html:'<strong>Clerk:</strong> Exhibit '+state.evidence+' admitted. Chain of custody verified. SHA-256: 0x'+Array.from(crypto.getRandomValues(new Uint8Array(16))).map(b=>b.toString(16).padStart(2,'0')).join('').substring(0,16)+'...'}
      ]
    },
    witness:{
      phase:2,
      speaker:'judge',
      msgs:[
        {type:'judge',html:'<strong>'+state.role+':</strong> Your Honor, I call my next witness to the stand.'},
        {type:'judge',html:'<strong>Judge Martinez:</strong> The witness is sworn in. Please state your name for the record.'},
        {type:'ai',html:'<strong>Witness:</strong> My name is '+(state.witnesses===0?'Sarah Johnson':'Michael Chen')+'. I was present at the time of the incident and can testify to what I observed.'}
      ],
      witness:true
    },
    objection:{
      phase:state.phase,
      speaker:state.role.toLowerCase()==='prosecution'?'defense':'prosecution',
      msgs:[
        {type:'ai',html:'<strong>'+state.role+':</strong> Objection, Your Honor! '+(Math.random()>.5?'That\'s hearsay.':'That\'s speculative and not based on personal knowledge.')},
        {type:'judge',html:'<strong>Judge Martinez:</strong> '+(Math.random()>.5?'Sustained. The jury will disregard that statement.':'Overruled. The witness may continue.')},
        {type:'system',html:'<strong>System:</strong> Objection logged. Ruling: '+(Math.random()>.5?'Sustained':'Overruled')+'. Transcript updated.'}
      ],
      objection:true
    },
    cross:{
      phase:3,
      speaker:state.role.toLowerCase()==='prosecution'?'defense':'prosecution',
      msgs:[
        {type:'ai',html:'<strong>'+state.role+':</strong> Witness, isn\'t it true that you were not in a position to clearly observe the events in question? Your view was partially obstructed, correct?'},
        {type:'ai',html:'<strong>Witness:</strong> I... I did my best to observe what was happening, but yes, there were some obstructions.'},
        {type:'judge',html:'<strong>Judge Martinez:</strong> Counsel, please stick to the facts established during direct examination.'}
      ]
    },
    closing:{
      phase:4,
      speaker:state.role.toLowerCase()==='prosecution'?'prosecution':'defense',
      msgs:[
        {type:'ai',html:'<strong>'+state.role+':</strong> Your Honor, members of the jury, we\'ve presented compelling evidence throughout this trial. The facts clearly support our position. We ask that you find in our favor based on the evidence presented.'},
        {type:'judge',html:'<strong>Judge Martinez:</strong> Thank you, counsel. The jury will now retire to deliberate.'}
      ]
    },
    deliberate:{
      phase:5,
      speaker:'judge',
      msgs:[
        {type:'system',html:'<strong>Jury Room:</strong> Jury has retired to deliberate. Estimated time: 45 minutes.'},
        {type:'system',html:'<strong>Jury Room:</strong> Jury has reached a verdict. Returning to courtroom.'},
        {type:'judge',html:'<strong>Judge Martinez:</strong> Has the jury reached a verdict?'}
      ]
    },
    verdict:{
      phase:6,
      speaker:'judge',
      msgs:[
        {type:'verdict',html:'<strong>Judge Martinez:</strong> Based on the evidence presented and the jury\'s deliberation, I find the defendant '+(Math.random()>.4?'NOT GUILTY':'GUILTY')+' of the charges. '+(Math.random()>.4?'Case dismissed.':'Sentencing will be scheduled for a later date.')+' Court is adjourned.'},
        {type:'system',html:'<strong>Bailiff:</strong> All rise. Court is adjourned.'},
        {type:'system',html:'<strong>System:</strong> Trial complete. Transcript saved to SCAF Vault. MockTrial session ended.'}
      ]
    }
  };
  
  const r=responses[action];
  if(!r)return;
  
  state.phase=r.phase;
  if(r.objection)state.objections++;
  if(r.witness)state.witnesses++;
  
  updatePhaseDots();
  document.getElementById('phaseDisplay').textContent=state.phases[r.phase];
  document.getElementById('statPhase').textContent=state.phases[r.phase];
  document.getElementById('statEvidence').textContent=state.evidence;
  document.getElementById('statObjections').textContent=state.objections;
  document.getElementById('statWitnesses').textContent=state.witnesses;
  
  highlightTile(r.speaker);
  
  if(r.objection){
    document.getElementById('preview').classList.add('objection-flash');
    setTimeout(()=>document.getElementById('preview').classList.remove('objection-flash'),600);
  }
  
  r.msgs.forEach((m,i)=>{
    setTimeout(()=>addMsg(m.type,m.html),i*600);
  });
  
  showToast(`Action executed: ${action}`, 'success');
}

// ============ RESET ============
function resetMock(){
  state={
    role:null,
    caseType:null,
    phase:-1,
    evidence:0,
    objections:0,
    witnesses:0,
