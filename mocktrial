<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>VideoCourts™ — MockTrial Lab with NC Remote Proceedings</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/fonts/inter@latest/latin-400-normal.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/fonts/inter@latest/latin-500-normal.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/fonts/inter@latest/latin-600-normal.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/fonts/inter@latest/latin-700-normal.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/fontsource/fonts/inter@latest/latin-800-normal.css">
<style>
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Inter',system-ui,sans-serif;background:#0f172a;color:#f1f5f9}
::-webkit-scrollbar{width:10px}
::-webkit-scrollbar-track{background:#0f172a}
::-webkit-scrollbar-thumb{background:#334155;border-radius:5px}
.grad-text{background:linear-gradient(135deg,#635bff 0%,#00d4aa 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.btn-primary{background:linear-gradient(135deg,#635bff,#00d4aa);color:white;border:none;padding:12px 24px;border-radius:10px;font-weight:600;font-size:14px;cursor:pointer;transition:all .2s;font-family:inherit;display:inline-flex;align-items:center;gap:8px}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(99,91,255,.3)}
.btn-secondary{background:#1e293b;color:#f1f5f9;border:1px solid #334155;padding:12px 24px;border-radius:10px;font-weight:600;font-size:14px;cursor:pointer;transition:all .2s;font-family:inherit;display:inline-flex;align-items:center;gap:8px}
.btn-secondary:hover{background:#334155}
.btn-danger{background:#ef4444;color:white;border:none;padding:12px 24px;border-radius:10px;font-weight:600;font-size:14px;cursor:pointer;transition:all .2s;font-family:inherit;display:inline-flex;align-items:center;gap:8px}
.btn-danger:hover{background:#dc2626}
.btn-success{background:#10b981;color:white;border:none;padding:12px 24px;border-radius:10px;font-weight:600;font-size:14px;cursor:pointer;transition:all .2s;font-family:inherit;display:inline-flex;align-items:center;gap:8px}
.card{background:#1e293b;border:1px solid #334155;border-radius:16px;padding:24px;transition:all .3s}
.card:hover{border-color:#635bff}
.badge{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:100px;font-size:11px;font-weight:700;letter-spacing:.02em}
.badge-live{background:rgba(239,68,68,.15);color:#fca5a5;border:1px solid rgba(239,68,68,.3)}
.badge-success{background:rgba(34,197,94,.15);color:#86efac}
.badge-warning{background:rgba(245,158,11,.15);color:#fcd34d}
.badge-info{background:rgba(99,91,255,.15);color:#c7d2fe}
.badge-purple{background:rgba(168,85,247,.15);color:#d8b4fe}
.toast{position:fixed;bottom:24px;right:24px;background:#0f172a;border:1px solid #334155;color:white;padding:14px 20px;border-radius:12px;box-shadow:0 10px 40px rgba(0,0,0,.5);display:flex;align-items:center;gap:10px;font-size:14px;font-weight:500;z-index:2000;transform:translateY(100px);opacity:0;transition:all .3s;max-width:90vw}
.toast.show{transform:translateY(0);opacity:1}
.toast.success{background:#065f46;border-color:#10b981}
.toast.error{background:#7f1d1d;border-color:#ef4444}
.mock-role{padding:16px;border-radius:12px;background:#1e293b;border:2px solid #334155;cursor:pointer;transition:all .2s}
.mock-role:hover{border-color:#635bff;transform:translateY(-2px)}
.mock-role.selected{border-color:#00d4aa;background:rgba(0,212,170,.08)}
.chat-box{background:#0f172a;border:1px solid #1e293b;border-radius:12px;padding:14px;height:320px;overflow-y:auto;font-size:13px;color:#e2e8f0}
.chat-msg{margin-bottom:10px;padding:10px 12px;border-radius:8px;background:rgba(255,255,255,.04);animation:fadeIn .3s}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
.chat-msg strong{color:#60a5fa;font-weight:600}
.chat-msg.ai{border-left:3px solid #635bff}
.chat-msg.system{border-left:3px solid #f59e0b;background:rgba(245,158,11,.05)}
.chat-msg.judge{border-left:3px solid #fbbf24;background:rgba(251,191,36,.05)}
.chat-msg.verdict{border-left:3px solid #22c55e;background:rgba(34,197,94,.08);padding:14px}
.video-tile{background:linear-gradient(135deg,#1e293b,#0f172a);border:1px solid #334155;border-radius:12px;aspect-ratio:16/10;display:flex;flex-direction:column;justify-content:flex-end;padding:14px;position:relative;overflow:hidden;transition:all .3s}
.video-tile.active{border-color:#00d4aa;box-shadow:0 0 0 2px rgba(0,212,170,.3)}
.video-tile::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(0,0,0,.7) 100%)}
.video-tile .vt-content{position:relative;z-index:1}
.vt-indicator{position:absolute;top:12px;right:12px;width:10px;height:10px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 3px rgba(34,197,94,.3);z-index:1}
.vt-speaking{position:absolute;top:12px;left:12px;display:flex;gap:2px;z-index:1}
.vt-speaking span{width:3px;height:12px;background:#00d4aa;border-radius:2px;animation:speak .5s infinite}
.vt-speaking span:nth-child(2){animation-delay:.1s}
.vt-speaking span:nth-child(3){animation-delay:.2s}
@keyframes speak{0%,100%{height:4px}50%{height:14px}}
.phase-indicator{display:flex;gap:4px;margin-bottom:16px}
.phase-dot{flex:1;height:4px;background:#334155;border-radius:2px;transition:all .3s}
.phase-dot.active{background:linear-gradient(90deg,#635bff,#00d4aa)}
.phase-dot.done{background:#22c55e}
.objection-flash{animation:objectionFlash .6s}
@keyframes objectionFlash{0%,100%{background:transparent}50%{background:rgba(239,68,68,.15)}}
.confidential-banner{background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.3);border-radius:8px;padding:12px;margin-top:12px}
.secure-link-box{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);border-radius:8px;padding:16px;margin-top:16px;display:none}
.input{width:100%;background:#0f172a;border:1px solid #334155;color:#f1f5f9;padding:10px 14px;border-radius:8px;font-size:14px}
.input:focus{outline:none;border-color:#635bff}
.select{width:100%;background:#0f172a;border:1px solid #334155;color:#f1f5f9;padding:10px 14px;border-radius:8px;font-size:14px}
.calendar-day{aspect-ratio:1;background:#1e293b;border:1px solid #334155;border-radius:8px;padding:8px;font-size:12px;cursor:pointer;transition:all .2s;position:relative}
.calendar-day:hover{border-color:#635bff;background:#334155}
.calendar-day.has-event{background:rgba(99,91,255,.2);border-color:#635bff}
.calendar-day.today{background:#635bff;color:white;border-color:#635bff}
.calendar-day .event-dot{position:absolute;top:5px;right:5px;width:6px;height:6px;border-radius:50%;background:#ef4444}
.nav-link{cursor:pointer;transition:all .2s}
.nav-link:hover{color:#00d4aa}
</style>
</head>
<body>

<!-- NAV -->
<nav class="sticky top-0 z-50 bg-slate-950/95 backdrop-blur border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white text-lg" style="background:linear-gradient(135deg,#635bff,#00d4aa)">
        <i class="fas fa-gavel"></i>
      </div>
      <div>
        <h1 class="text-lg font-bold leading-tight">VideoCourts<span class="text-xs text-slate-400 align-super">™</span></h1>
        <p class="text-[10px] text-slate-500 leading-tight">MockTrial Lab · NC Remote Proceedings · v5.0.3</p>
      </div>
    </div>
    <div class="hidden md:flex items-center gap-6 text-sm">
      <a class="nav-link" onclick="scrollToSection('setup')">Setup</a>
      <a class="nav-link" onclick="scrollToSection('preview')">Preview</a>
      <a class="nav-link" onclick="scrollToSection('jailcourt')">JailCourt/DACJJ</a>
      <a class="nav-link" onclick="scrollToSection('calendar')">Calendar</a>
      <a class="nav-link" onclick="scrollToSection('demo')">Live Demo</a>
    </div>
    <button onclick="resetMock()" class="btn-secondary text-sm"><i class="fas fa-rotate"></i>Reset</button>
  </div>
</nav>

<!-- HERO -->
<section class="relative overflow-hidden border-b border-slate-800" style="background:linear-gradient(135deg,#0f172a 0%,#1e293b 50%,#0f172a 100%)">
  <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full" style="background:radial-gradient(circle,rgba(99,91,255,.2),transparent 70%)"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 rounded-full" style="background:radial-gradient(circle,rgba(0,212,170,.15),transparent 70%)"></div>
  <div class="relative z-10 max-w-7xl mx-auto px-4 md:px-6 py-16 md:py-20">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-500/20 text-blue-300 text-sm mb-5 border border-blue-500/30">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      Aligned with NC Chief Justice's Task Force on Remote Proceedings
    </div>
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-4 leading-tight">
      Mock<span class="grad-text">Trial</span> Lab + NC Remote Proceedings
    </h1>
    <p class="text-lg text-slate-400 max-w-2xl mb-6">Full courtroom simulator with  Judicial District routing, JailCourt/DACJJ integration, Central Regional Hospital capacity hearings, and confidential attorney-client consultation routing. Built for legal training and Task Force mandate compliance.</p>
    <div class="flex flex-wrap gap-3">
      <button onclick="scrollToSection('setup')" class="btn-primary text-base px-6 py-3"><i class="fas fa-play"></i>Start Mock Trial</button>
      <button onclick="scrollToSection('jailcourt')" class="btn-success text-base px-6 py-3"><i class="fas fa-building-shield"></i>Schedule JailCourt/DACJJ</button>
      <button onclick="scrollToSection('demo')" class="btn-secondary text-base px-6 py-3"><i class="fas fa-magic"></i>Live Demo Mode</button>
    </div>
  </div>
</section>

<!-- SETUP -->
<section id="setup" class="py-12 md:py-16 border-b border-slate-800">
  <div class="max-w-6xl mx-auto px-4 md:px-6">
    <div class="text-center mb-10">
      <div class="inline-block px-4 py-1.5 rounded-full bg-purple-500/10 text-purple-400 text-xs font-bold uppercase tracking-wider mb-4">Step 1 & 2</div>
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-3">Configure Your Trial</h2>
      <p class="text-slate-400">Choose your role and case type to begin.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <div class="card">
        <h3 class="text-lg font-bold mb-1">Choose Your Role</h3>
        <p class="text-sm text-slate-400 mb-4">Each role has different objectives and available actions.</p>
        <div class="grid grid-cols-2 gap-3">
          <div class="mock-role" onclick="selectRole('Prosecution',this)">
            <i class="fas fa-gavel text-red-400 text-2xl mb-2"></i>
            <div class="font-bold text-sm">Prosecution</div>
            <div class="text-xs text-slate-400 mt-1">Present the case against defendant</div>
          </div>
          <div class="mock-role" onclick="selectRole('Defense',this)">
            <i class="fas fa-shield-halved text-blue-400 text-2xl mb-2"></i>
            <div class="font-bold text-sm">Defense</div>
            <div class="text-xs text-slate-400 mt-1">Defend the accused</div>
          </div>
          <div class="mock-role" onclick="selectRole('Judge',this)">
            <i class="fas fa-scale-balanced text-amber-400 text-2xl mb-2"></i>
            <div class="font-bold text-sm">Judge</div>
            <div class="text-xs text-slate-400 mt-1">Preside over proceedings</div>
          </div>
          <div class="mock-role" onclick="selectRole('Jury',this)">
            <i class="fas fa-users text-emerald-400 text-2xl mb-2"></i>
            <div class="font-bold text-sm">Jury</div>
            <div class="text-xs text-slate-400 mt-1">Deliver the verdict</div>
          </div>
        </div>
      </div>

      <div class="card">
        <h3 class="text-lg font-bold mb-1">Select Case Type</h3>
        <p class="text-sm text-slate-400 mb-4">Different cases have different evidence and procedures.</p>
        <div class="grid grid-cols-2 gap-3">
          <div class="mock-role" onclick="selectCase('Criminal — Theft',this)">
            <i class="fas fa-mask text-red-400 text-2xl mb-2"></i>
            <div class="font-bold text-sm">Criminal — Theft</div>
          </div>
          <div class="mock-role" onclick="selectCase('Criminal — Assault',this)">
            <i class="fas fa-hand-fist text-orange-400 text-2xl mb-2"></i>
            <div class="font-bold text-sm">Criminal — Assault</div>
          </div>
          <div class="mock-role" onclick="selectCase('Civil — Contract Dispute',this)">
            <i class="fas fa-file-contract text-blue-400 text-2xl mb-2"></i>
            <div class="font-bold text-sm">Civil — Contract</div>
          </div>
          <div class="mock-role" onclick="selectCase('Family — Custody',this)">
            <i class="fas fa-people-roof text-pink-400 text-2xl mb-2"></i>
            <div class="font-bold text-sm">Family — Custody</div>
          </div>
          <div class="mock-role" onclick="selectCase('Traffic — DUI',this)">
            <i class="fas fa-car text-amber-400 text-2xl mb-2"></i>
            <div class="font-bold text-sm">Traffic — DUI</div>
          </div>
          <div class="mock-role" onclick="selectCase('Small Claims',this)">
            <i class="fas fa-coins text-emerald-400 text-2xl mb-2"></i>
            <div class="font-bold text-sm">Small Claims</div>
          </div>
        </div>
      </div>
    </div>

    <button onclick="startTrial()" class="btn-primary w-full justify-center text-base py-4 text-lg">
      <i class="fas fa-play"></i>Begin Mock Trial
    </button>
  </div>
</section>

<!-- PREVIEW / ACTIVE TRIAL -->
<section id="preview" class="py-12 md:py-16 border-b border-slate-800 bg-slate-950/50">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="text-center mb-10">
      <div class="inline-block px-4 py-1.5 rounded-full bg-red-500/10 text-red-400 text-xs font-bold uppercase tracking-wider mb-4">Live Preview</div>
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-3">Courtroom <span class="grad-text">Preview</span></h2>
      <p class="text-slate-400" id="previewSubtitle">Start a trial to see the courtroom come alive.</p>
    </div>

    <!-- Trial Status Bar -->
    <div class="card mb-6">
      <div class="flex items-center justify-between flex-wrap gap-4 mb-4">
        <div>
          <div class="flex items-center gap-3 mb-1">
            <h3 class="text-xl font-bold" id="trialTitle">Awaiting Trial Start</h3>
            <span class="badge badge-info" id="trialBadge">IDLE</span>
          </div>
          <p class="text-sm text-slate-400" id="trialSubtitle2">Select role and case type above to begin.</p>
        </div>
        <div class="flex items-center gap-4">
          <div class="text-right">
            <div class="text-xs text-slate-500 uppercase font-bold">Phase</div>
            <div class="font-bold" id="phaseDisplay">—</div>
          </div>
          <div class="text-right">
            <div class="text-xs text-slate-500 uppercase font-bold">Role</div>
            <div class="font-bold" id="roleDisplay">—</div>
          </div>
        </div>
      </div>

      <!-- Phase Progress -->
      <div class="phase-indicator">
        <div class="phase-dot" id="phase-0"></div>
        <div class="phase-dot" id="phase-1"></div>
        <div class="phase-dot" id="phase-2"></div>
        <div class="phase-dot" id="phase-3"></div>
        <div class="phase-dot" id="phase-4"></div>
        <div class="phase-dot" id="phase-5"></div>
        <div class="phase-dot" id="phase-6"></div>
      </div>
      <div class="flex justify-between text-xs text-slate-500 font-semibold">
        <span>Opening</span><span>Evidence</span><span>Witness</span><span>Cross</span><span>Closing</span><span>Deliberation</span><span>Verdict</span>
      </div>
    </div>

    <!-- Courtroom Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
      <div class="video-tile" id="tile-judge">
        <span class="vt-indicator"></span>
        <div class="vt-speaking" id="speak-judge" style="display:none"><span></span><span></span><span></span></div>
        <div class="vt-content">
          <div class="font-semibold text-sm text-white">Hon. Martinez</div>
          <div class="text-xs text-slate-400">Presiding Judge</div>
        </div>
      </div>
      <div class="video-tile" id="tile-prosecution">
        <span class="vt-indicator"></span>
        <div class="vt-speaking" id="speak-prosecution" style="display:none"><span></span><span></span><span></span></div>
        <div class="vt-content">
          <div class="font-semibold text-sm text-white">Prosecution</div>
          <div class="text-xs text-slate-400">State Counsel</div>
        </div>
      </div>
      <div class="video-tile" id="tile-defense">
        <span class="vt-indicator"></span>
        <div class="vt-speaking" id="speak-defense" style="display:none"><span></span><span></span><span></span></div>
        <div class="vt-content">
          <div class="font-semibold text-sm text-white">Defense</div>
          <div class="text-xs text-slate-400">Defense Counsel</div>
        </div>
      </div>
      <div class="video-tile" id="tile-defendant">
        <span class="vt-indicator"></span>
        <div class="vt-speaking" id="speak-defendant" style="display:none"><span></span><span></span><span></span></div>
        <div class="vt-content">
          <div class="font-semibold text-sm text-white">Defendant</div>
          <div class="text-xs text-slate-400">Accused</div>
        </div>
      </div>
    </div>

    <!-- Stats Row -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
      <div class="card text-center">
        <div class="text-xs text-slate-500 uppercase font-bold mb-1">Evidence Presented</div>
        <div class="text-3xl font-extrabold grad-text" id="statEvidence">0</div>
      </div>
      <div class="card text-center">
        <div class="text-xs text-slate-500 uppercase font-bold mb-1">Objections</div>
        <div class="text-3xl font-extrabold text-red-400" id="statObjections">0</div>
      </div>
      <div class="card text-center">
        <div class="text-xs text-slate-500 uppercase font-bold mb-1">Witnesses Called</div>
        <div class="text-3xl font-extrabold text-amber-400" id="statWitnesses">0</div>
      </div>
      <div class="card text-center">
        <div class="text-xs text-slate-500 uppercase font-bold mb-1">Current Phase</div>
        <div class="text-lg font-extrabold text-emerald-400" id="statPhase">—</div>
      </div>
    </div>

    <!-- Transcript / Chat -->
    <div class="card mb-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-bold text-lg"><i class="fas fa-file-lines mr-2 text-blue-400"></i>Live Transcript</h3>
        <div class="flex gap-2">
          <button onclick="exportTranscript()" class="btn-secondary text-xs"><i class="fas fa-download"></i>Export</button>
          <button onclick="clearTranscript()" class="btn-secondary text-xs"><i class="fas fa-trash"></i>Clear</button>
        </div>
      </div>
      <div class="chat-box" id="transcript">
        <div class="chat-msg system"><strong>System:</strong> MockTrial Lab ready. Configure your trial above and click "Begin Mock Trial" to start.</div>
      </div>
    </div>

    <!-- Controls -->
    <div id="controls" class="card">
      <h3 class="font-bold text-lg mb-4"><i class="fas fa-gamepad mr-2 text-purple-400"></i>Trial Controls</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <button onclick="trialAction('opening')" class="btn-secondary justify-center"><i class="fas fa-comment-dots"></i>Opening Statement</button>
        <button onclick="trialAction('evidence')" class="btn-secondary justify-center"><i class="fas fa-folder-open"></i>Present Evidence</button>
        <button onclick="trialAction('witness')" class="btn-secondary justify-center"><i class="fas fa-user"></i>Call Witness</button>
        <button onclick="trialAction('objection')" class="btn-danger justify-center"><i class="fas fa-hand"></i>Object!</button>
        <button onclick="trialAction('cross')" class="btn-secondary justify-center"><i class="fas fa-question"></i>Cross-Examine</button>
        <button onclick="trialAction('closing')" class="btn-secondary justify-center"><i class="fas fa-flag-checkered"></i>Closing Argument</button>
        <button onclick="trialAction('deliberate')" class="btn-secondary justify-center"><i class="fas fa-users"></i>Deliberate</button>
        <button onclick="trialAction('verdict')" class="btn-primary justify-center"><i class="fas fa-gavel"></i>Deliver Verdict</button>
      </div>
    </div>
  </div>
</section>

<!-- JAILCOURT / DACJJ -->
<section id="jailcourt" class="py-12 md:py-16 border-b border-slate-800">
  <div class="max-w-5xl mx-auto px-4 md:px-6">
    <div class="text-center mb-10">
      <div class="inline-block px-4 py-1.5 rounded-full bg-blue-500/10 text-blue-400 text-xs font-bold uppercase tracking-wider mb-4">NC Task Force Mandate</div>
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-3">JailCourt / DACJJ Remote Proceedings</h2>
      <p class="text-slate-400">Facilitate remote hearings between NC state courts and county detention/DACJJ facilities. Enable Central Regional Hospital capacity determinations.</p>
    </div>

    <div class="card mb-6">
      <h2 class="text-2xl font-bold mb-4">Schedule Remote Proceeding</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold mb-2">Case Number</label>
          <input type="text" id="jcCase" class="input" placeholder="e.g. CR-24-1867">
        </div>
        <div>
          <label class="block text-sm font-semibold mb-2">Proceeding Type</label>
          <select id="jcType" class="select">
            <option>First Appearance</option>
            <option>Capacity to Proceed Determination</option>
            <option>Bail Hearing</option>
            <option>Arraignment</option>
