    const court = document.getElementById('demoCourt').value;
    
    hearings.push({
      id: hearings.length + 1,
      caseNumber: caseNum,
      type: type + ' (Demo)',
      date: new Date().toISOString(),
      location: facility + ' to ' + court,
      status: 'Scheduled'
    });
    
    showToast('Demo proceeding scheduled! Check the Calendar tab.', 'success');
    renderUpcomingHearings();
    renderCalendar();
    setTimeout(() => scrollToSection('calendar'), 1500);
  }, 1000);
}

