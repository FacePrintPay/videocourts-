// ============ TRANSCRIPT ============
function exportTranscript(){
  const transcript=document.getElementById('transcript').innerText;
  const blob=new Blob([transcript],{type:'text/plain'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  a.href=url;
  a.download='mocktrial-transcript-'+Date.now()+'.txt';
  a.click();
  URL.revokeObjectURL(url);
  showToast('Transcript exported','success');
}
function clearTranscript(){
  document.getElementById('transcript').innerHTML='<div class="chat-msg system"><strong>System:</strong> Transcript cleared.</div>';
  showToast('Transcript cleared','success');
}

// ============ JAILCOURT / DACJJ ============
function updateFacilities() {
  const type = document.getElementById('jcFacilityType').value;
  const facilitySelect = document.getElementById('jcFacility');
  facilitySelect.innerHTML = '<option value="">Select Specific Facility...</option>';
  if (type && FACILITIES[type]) {
    FACILITIES[type].forEach(facility => {
      const option = document.createElement('option');
      option.value = facility;
      option.textContent = facility;
      facilitySelect.appendChild(option);
    });
    showToast(`Facility type selected: ${type}`, 'success');
