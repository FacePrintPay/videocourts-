  document.getElementById('roleDisplay').textContent='—';
  document.getElementById('phaseDisplay').textContent='—';
  document.getElementById('statEvidence').textContent='0';
  document.getElementById('statObjections').textContent='0';
  document.getElementById('statWitnesses').textContent='0';
